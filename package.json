{
  "name": "mission-rescue",
  "version": "1.0.0",
  "description": "Mission Rescue: Agent Proof & Recovery. The truth about an AI agent's mission: what is really done (with proof), why it stopped, and how to resume it safely.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tools/server.mjs --open",
    "test": "node --test",
    "demo:reset": "node tools/mission-rescue.mjs demo-reset",
    "demo:agent": "node tools/mission-rescue.mjs demo-agent missions/weekly-report --delay 1500",
    "demo:honesty": "node tools/mission-rescue.mjs honesty-test missions/weekly-report",
    "check": "node tools/mission-rescue.mjs check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Daniel221287/mission-rescue.git"
  },
  "homepage": "https://daniel221287.github.io/mission-rescue/"
}
